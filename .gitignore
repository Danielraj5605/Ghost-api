# Secrets: API keys live in .env (copy .env.example). Never commit them.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials*.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Ghost API data: the database holds captured traffic, cached LLM answers and lessons
output/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Build artifacts
build/
dist/

# Screenshots and other run files kept next to the database
*_files/

# Dashboard frontend (built output in ghost_api/web/static is committed)
web/node_modules/
web/dist/

# Logs, editors and OS files
*.log
.vscode/
.idea/
.DS_Store
Thumbs.db
