/**
 * Live tests for {{ spec.class_name }} (generated by Ghost API {{ version }}).
 *
 * Run with: node --test {{ module }}.test.ts   (Node 23.6+ runs TypeScript directly)
 *
 * They call the real {{ spec.domain }} API, slowly (1 request per second), with values seen
 * while exploring the site. A failure usually means the site changed its API.
 */
import { test } from "node:test";
import assert from "node:assert/strict";
import { {{ spec.class_name }} } from "./{{ module }}.ts";

const api = new {{ spec.class_name }}();
{% for m in spec.methods if m.testable %}

test("test_{{ m.name }}", async (t) => {
{% for c in m | creds(spec, 'any') %}
  if (!process.env[{{ c.env | json }}]) {
    t.skip("set {{ c.env }} to run this test");
    return;
  }
{% endfor %}
  const result = await api.{{ m.name | camel }}({% for p in m.required %}{{ p.example | js }}{% if not loop.last %}, {% endif %}{% endfor %});
  assert.ok(result !== null && result !== undefined);
});
{% if m.page_param %}

test("test_iter_{{ m.name }}", async (t) => {
{% for c in m | creds(spec, 'any') %}
  if (!process.env[{{ c.env | json }}]) {
    t.skip("set {{ c.env }} to run this test");
    return;
  }
{% endfor %}
  const pages = [];
  for await (const page of api.iter{{ (m.name | camel)[:1] | upper }}{{ (m.name | camel)[1:] }}({% for p in m.required %}{{ p.example | js }}, {% endfor %}{ maxPages: 2 })) {
    pages.push(page);
  }
  assert.ok(pages.length >= 1);
});
{% endif %}
{% endfor %}
{% for m in spec.methods if not m.testable %}

test("test_{{ m.name }}", { skip: "no example values were captured for its required arguments" }, () => {});
{% endfor %}
