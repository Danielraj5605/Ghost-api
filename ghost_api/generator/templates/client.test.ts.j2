/**
 * Tests for {{ spec.class_name }} (generated by Ghost API {{ version }}).
 *
 * Run with: node --test {{ module }}.test.ts   (Node 23.6+ runs TypeScript directly)
 *
 * By default they replay replies recorded from {{ spec.domain }} (cassettes.json): offline,
 * fast and the same every time, so they fit CI. With GHOST_API_LIVE=1 they call the real
 * API, slowly (1 request per second); a failure then usually means the site changed its API.
 */
import { test } from "node:test";
import assert from "node:assert/strict";
import { existsSync, readFileSync } from "node:fs";
import { {{ spec.class_name }} } from "./{{ module }}.ts";

interface Reply {
  method: string;
  path: string;
  path_regex: string;
  query: Record<string, string>;
  operation: string | null;
  status: number;
  content_type: string;
  body: string;
}

const CASSETTES = new URL("./cassettes.json", import.meta.url);
const LIVE = process.env.GHOST_API_LIVE === "1" || !existsSync(CASSETTES);
const REPLIES: Reply[] = LIVE ? [] : JSON.parse(readFileSync(CASSETTES, "utf-8")).replies;

/** The recorded reply closest to a request: same path first, then query values. */
async function replay(input: URL | RequestInfo, init?: RequestInit): Promise<Response> {
  const url = new URL(String(input));
  const method = (init?.method ?? "GET").toUpperCase();
  let operation: string | null = null;
  if (typeof init?.body === "string") {
    try {
      operation = JSON.parse(init.body).operationName ?? null;
    } catch {
      operation = null;
    }
  }
  const found = REPLIES.filter(
    (r) =>
      r.method === method &&
      new RegExp(`^${r.path_regex}$`).test(url.pathname) &&
      (operation === null || r.operation === null || r.operation === operation),
  );
  if (found.length === 0) {
    const error = `no recorded reply for ${method} ${url.pathname}`;
    return new Response(JSON.stringify({ error }), { status: 404 });
  }
  const score = (r: Reply): number[] => [
    r.path === url.pathname ? 1 : 0,
    Object.entries(r.query).filter(([k, v]) => url.searchParams.get(k) === v).length,
    -Math.abs(Object.keys(r.query).length - [...url.searchParams.keys()].length),
  ];
  const better = (a: number[], b: number[]): boolean => {
    for (let i = 0; i < a.length; i++) if (a[i] !== b[i]) return a[i] > b[i];
    return false;
  };
  const best = found.reduce((a, b) => (better(score(b), score(a)) ? b : a));
  return new Response(best.body, { status: best.status, headers: { "content-type": best.content_type } });
}

const api = LIVE
  ? new {{ spec.class_name }}()
  : new {{ spec.class_name }}({
{% for c in spec.credentials %}
      {{ c.arg | camel }}: "offline-placeholder",
{% endfor %}
      fetch: replay as typeof fetch,
      maxRequestsPerSecond: 0,
    });
{% for m in spec.methods if m.testable %}

test("test_{{ m.name }}", async (t) => {
{% for c in m | creds(spec, 'any') %}
  if (LIVE && !process.env[{{ c.env | json }}]) {
    t.skip("set {{ c.env }} to run this test against the live API");
    return;
  }
{% endfor %}
  const result = await api.{{ m.name | camel }}({% for p in m.required %}{{ p.example | js }}{% if not loop.last %}, {% endif %}{% endfor %});
  assert.ok(result !== null && result !== undefined);
});
{% if m.page_param %}

test("test_iter_{{ m.name }}", async (t) => {
{% for c in m | creds(spec, 'any') %}
  if (LIVE && !process.env[{{ c.env | json }}]) {
    t.skip("set {{ c.env }} to run this test against the live API");
    return;
  }
{% endfor %}
  const pages = [];
  for await (const page of api.iter{{ (m.name | camel)[:1] | upper }}{{ (m.name | camel)[1:] }}({% for p in m.required %}{{ p.example | js }}, {% endfor %}{ maxPages: 2 })) {
    pages.push(page);
  }
  assert.ok(pages.length >= 1);
});
{% endif %}
{% endfor %}
{% for m in spec.methods if not m.testable %}

test("test_{{ m.name }}", { skip: "no example values were captured for its required arguments" }, () => {});
{% endfor %}
