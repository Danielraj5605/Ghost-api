# Generated by Ghost API. Install with:  pip install .   (or publish it to your own index)
[build-system]
requires = ["setuptools>=77"]
build-backend = "setuptools.build_meta"

[project]
name = "{{ dist }}"
version = "{{ version }}"
description = "Unofficial typed client for {{ spec.domain }} (generated by Ghost API)"
readme = "README.md"
requires-python = ">=3.10"
dependencies = ["httpx>=0.27", "pydantic>=2.7"]
classifiers = ["Typing :: Typed", "Private :: Do Not Upload"]

[project.optional-dependencies]
test = ["pytest>=8"]

[tool.setuptools.packages.find]
where = ["src"]

[tool.setuptools.package-data]
{{ module }} = ["py.typed"]
