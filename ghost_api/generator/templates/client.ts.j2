/**
 * {{ spec.class_name }}: a typed TypeScript client for {{ spec.domain }}.
 *
 * Generated by Ghost API {{ version }} on {{ generated_on }} from the site's own traffic.
 * Made for Node 18+ (servers, scripts, serverless functions). The types describe responses
 * seen while exploring; they are not checked at runtime.
 *
 * In a web page: browsers don't let code set the User-Agent header, so this client doesn't
 * try there (the site can't tell the calls come from it), and the browser only lets the page
 * read the replies if the site allows cross-origin requests (CORS), which internal APIs
 * rarely do. Call the client from your own server and have the page call that instead.
 *
 * This is an unofficial client for a website's internal API. It can change without
 * notice, and the site's terms of service still apply. Re-run `ghost-api run` to refresh.
 */
{% for m in spec.models %}

{% if m.doc %}
/** {{ m.doc | doc }} */
{% endif %}
export interface {{ m.name }} {
{% for f in m.fields %}
  {{ f | ts_prop }}{% if f.optional %}?{% endif %}: {{ f.type | ts_type }};
{% endfor %}
  /** Fields not seen while exploring. */
  [extra: string]: unknown;
}
{% endfor %}

/** An API call failed. `status` is the HTTP status (0 for network errors). */
export class {{ spec.error_class }} extends Error {
  readonly status: number;
  readonly body: unknown;

  constructor(status: number, message: string, body?: unknown) {
    super(status ? `HTTP ${status}: ${message}` : message);
    this.name = "{{ spec.error_class }}";
    this.status = status;
    this.body = body;
  }
}

export interface {{ spec.class_name }}Options {
  baseUrl?: string;
{% for c in spec.credentials %}
  /** Defaults to the {{ c.env }} environment variable (Node). */
  {{ c.arg | camel }}?: string;
{% endfor %}
  maxRequestsPerSecond?: number;
  maxRetries?: number;
  fetch?: typeof fetch;
}

const USER_AGENT = {{ user_agent | json }};
const RETRY_STATUSES = new Set([429, 500, 502, 503, 504]);
// Guards some sites put before JSON so other sites can't read it (Google: ")]}'").
const JSON_GUARDS = [")]}'", "while(1);", "for(;;);"];
const CREDENTIAL_ENV: Record<string, string> = {
{% for c in spec.credentials %}
  {{ c.arg | camel | json }}: {{ c.env | json }},
{% endfor %}
};

/** True in a web page (and web workers), where the User-Agent header can't be set. */
function inBrowser(): boolean {
  const g = globalThis as { document?: unknown; importScripts?: unknown };
  return g.document !== undefined || typeof g.importScripts === "function";
}

function readEnv(name: string): string | undefined {
  const proc = (globalThis as { process?: { env?: Record<string, string | undefined> } }).process;
  return proc?.env?.[name];
}

function parseJson(text: string): unknown {
  let body = text.trimStart();
  const guard = JSON_GUARDS.find((g) => body.startsWith(g));
  if (guard) body = body.slice(guard.length).replace(/^,/, "").trimStart();
  return JSON.parse(body);
}

function sleep(ms: number): Promise<void> {
  return new Promise((resolve) => setTimeout(resolve, ms));
}

export class {{ spec.class_name }} {
  static readonly BASE_URL = {{ spec.base_url | json }};

  readonly baseUrl: string;
  private readonly credentials: Record<string, string | undefined>;
  private readonly interval: number;
  private readonly maxRetries: number;
  private readonly fetchImpl: typeof fetch;
  private lastRequest = 0;

  constructor(options: {{ spec.class_name }}Options = {}) {
    this.baseUrl = (options.baseUrl ?? {{ spec.class_name }}.BASE_URL).replace(/\/+$/, "");
    this.credentials = {
{% for c in spec.credentials %}
      {{ c.arg | camel | json }}: options.{{ c.arg | camel }} ?? readEnv({{ c.env | json }}),
{% endfor %}
    };
    const rate = options.maxRequestsPerSecond ?? 1;
    this.interval = rate > 0 ? 1000 / rate : 0;
    this.maxRetries = options.maxRetries ?? 3;
    this.fetchImpl = options.fetch ?? globalThis.fetch.bind(globalThis);
  }
{% for m in spec.methods %}

  /**
   * {{ m.summary | doc }}
   *
   * `{{ m.http_method }} {{ (m.host and 'https://' ~ m.host) or spec.base_url }}{{ m.path }}`
   */
  async {{ m.name | camel }}(
{% for p in m.required %}
    {{ p.name | camel }}: {{ p.type | ts_type }},
{% endfor %}
{% if m.optional %}
    opts: {
{% for p in m.optional %}
      {{ p.name | camel }}?: {{ p.type | ts_type }}{% if not p.required and (p.default is none or p.default == "None") %} | null{% endif %};
{% endfor %}
    } = {},
{% endif %}
  ): Promise<{{ m.response_type | ts_type }}> {
    const data = await this.request(
      "{{ m.http_method }}",
      {% if m.host %}"https://{{ m.host }}"{% else %}this.baseUrl{% endif %} + {{ m | path_expr }},
      {
{% for p in m.by_location('query') %}
        {{ p.wire | json }}: {{ p | value }},
{% endfor %}
{% for c in m | creds(spec, 'query') %}
        {{ c.wire | json }}: this.credential({{ c.arg | camel | json }}),
{% endfor %}
      },
      {
{% for name, value in m.headers.items() %}
        {{ name | json }}: {{ value | json }},
{% endfor %}
{% for c in m | creds(spec, 'header') %}
        {{ c.wire | json }}: this.credential({{ c.arg | camel | json }}),
{% endfor %}
      },
{% if m.by_location('body') %}
      {
{% for p in m.by_location('body') %}
        {{ p.wire | json }}: {{ p | value }},
{% endfor %}
      },
{% endif %}
    );
    return data as {{ m.response_type | ts_type }};
  }
{% if m.page_param %}
{% set pp = m.page_param %}

  /**
   * Yield each page of `{{ m.name | camel }}()` until the results run out.
   * Pages by {{ m.pagination.style }} using `{{ pp.wire }}`. Set `maxPages` to stop early.
   */
  async *iter{{ (m.name | camel)[:1] | upper }}{{ (m.name | camel)[1:] }}(
{% for p in m.required %}
    {{ p.name | camel }}: {{ p.type | ts_type }},
{% endfor %}
    opts: {
{% for p in m.optional if p.name != pp.name %}
      {{ p.name | camel }}?: {{ p.type | ts_type }}{% if p.default is none or p.default == "None" %} | null{% endif %};
{% endfor %}
      start?: {{ pp.type | ts_type }};
      maxPages?: number;
    } = {},
  ): AsyncGenerator<{{ m.response_type | ts_type }}> {
    const { start, maxPages, ...rest } = opts;
    let position: unknown = start ?? {{ pp.default | js }};
    let previous = "";
    for (let pages = 0; maxPages === undefined || pages < maxPages; pages++) {
      const page = await this.{{ m.name | camel }}(
{% for p in m.required %}
        {{ p.name | camel }},
{% endfor %}
        { ...rest, {{ pp.name | camel }}: position as {{ pp.type | ts_type }} },
      );
      const items = findItems(page);
      const fingerprint = JSON.stringify(items);
      if (!items || items.length === 0 || fingerprint === previous) return;
      yield page;
      if (hasMore(page) === false) return;
      previous = fingerprint;
{% if m.pagination.style == "cursor" %}
      position = nextCursor(page);
      if (position === undefined) return;
{% elif m.pagination.style == "offset" %}
      position = Number(position ?? 0) + items.length;
{% else %}
      position = Number(position ?? 0) + 1;
{% endif %}
    }
  }
{% endif %}
{% endfor %}

  // --- plumbing ---

  private credential(name: string): string {
    const value = this.credentials[name];
    if (!value) {
      const env = CREDENTIAL_ENV[name] ?? "";
      throw new {{ spec.error_class }}(0, `Missing credential: pass ${name} or set ${env}`);
    }
    return value;
  }

  private async request(
    method: string,
    url: string,
    query: Record<string, unknown>,
    headers: Record<string, string>,
    body?: Record<string, unknown>,
  ): Promise<unknown> {
    const target = new URL(url);
    for (const [key, value] of Object.entries(query)) {
      if (value !== undefined && value !== null) target.searchParams.set(key, String(value));
    }
    const init: RequestInit = {
      method,
      headers: {
        ...(inBrowser() ? {} : { "User-Agent": USER_AGENT }),
        Accept: "application/json",
        ...headers,
      },
    };
    if (body !== undefined) {
      const clean = Object.fromEntries(Object.entries(body).filter(([, v]) => v !== undefined && v !== null));
      init.body = JSON.stringify(clean);
      init.headers = { ...init.headers, "Content-Type": "application/json" };
    }
    for (let attempt = 0; ; attempt++) {
      const wait = this.lastRequest + this.interval - Date.now();
      if (wait > 0) await sleep(wait);
      this.lastRequest = Date.now();
      let response: Response;
      try {
        response = await this.fetchImpl(target, init);
      } catch (error) {
        if (attempt >= this.maxRetries) {
          throw new {{ spec.error_class }}(0, `network error: ${String(error)}`);
        }
        await sleep(1000 * 2 ** attempt);
        continue;
      }
      if (RETRY_STATUSES.has(response.status) && attempt < this.maxRetries) {
        const retryAfter = Number(response.headers.get("retry-after"));
        await sleep(Number.isFinite(retryAfter) && retryAfter >= 0 ? retryAfter * 1000 : 1000 * 2 ** attempt);
        continue;
      }
      const text = await response.text();
      let data: unknown;
      try {
        data = parseJson(text);
      } catch {
        throw new {{ spec.error_class }}(response.status, "response is not JSON", text.slice(0, 500));
      }
      if (!response.ok) throw new {{ spec.error_class }}(response.status, response.statusText, data);
      return data;
    }
  }
}

function findItems(data: unknown, depth = 0): unknown[] | undefined {
  if (Array.isArray(data)) return data;
  if (data === null || typeof data !== "object" || depth > 2) return undefined;
  let best: unknown[] | undefined;
  for (const value of Object.values(data)) {
    const found = Array.isArray(value) ? value : findItems(value, depth + 1);
    if (found && (!best || found.length > best.length)) best = found;
  }
  return best;
}

function hasMore(data: unknown): boolean | undefined {
  if (data === null || typeof data !== "object") return undefined;
  const record = data as Record<string, unknown>;
  for (const key of ["has_next", "hasNext", "has_more", "hasMore"]) {
    if (typeof record[key] === "boolean") return record[key] as boolean;
  }
  return undefined;
}

function nextCursor(data: unknown): string | undefined {
  if (data === null || typeof data !== "object") return undefined;
  const record = data as Record<string, unknown>;
  const places = [record, ...["meta", "pagination", "paging", "pageInfo", "links"]
    .map((k) => record[k])
    .filter((v): v is Record<string, unknown> => v !== null && typeof v === "object")];
  for (const place of places) {
    for (const key of ["next_cursor", "nextCursor", "cursor", "next", "after", "endCursor",
      "next_page_token", "nextPageToken"]) {
      const value = place[key];
      if ((typeof value === "string" && value) || typeof value === "number") return String(value);
    }
  }
  return undefined;
}
