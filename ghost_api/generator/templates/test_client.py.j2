"""Tests for {{ spec.class_name }} (generated by Ghost API {{ version }}).

By default they replay replies recorded from {{ spec.domain }} (cassettes.json): offline,
fast and the same every time, so they fit CI. With GHOST_API_LIVE=1 they call the real API,
slowly (1 request per second), with values seen while exploring; a failure then usually
means the site changed its API: `ghost-api diff --live` says what changed.
"""

from __future__ import annotations

import json
import os
import re
import sys
from collections.abc import Iterator
from pathlib import Path
from typing import Any

import httpx
import pytest

sys.path.insert(0, str(Path(__file__).parent))

from {{ module }} import {{ spec.class_name }}  # noqa: E402

CASSETTES = Path(__file__).parent / "cassettes.json"
LIVE = os.environ.get("GHOST_API_LIVE") == "1" or not CASSETTES.exists()
REPLIES: list[dict[str, Any]] = (
    [] if LIVE else json.loads(CASSETTES.read_text(encoding="utf-8"))["replies"]
)


def _replay(request: httpx.Request) -> httpx.Response:
    """The recorded reply closest to this request: same path first, then query values."""
    query = dict(request.url.params)
    operation = None
    if request.content:
        try:
            body = json.loads(request.content)
            operation = body.get("operationName") if isinstance(body, dict) else None
        except ValueError:
            pass
    found = [
        r for r in REPLIES
        if r["method"] == request.method
        and re.fullmatch(r["path_regex"], request.url.path)
        and (operation is None or r.get("operation") in (None, operation))
    ]  # fmt: skip
    if not found:
        message = f"no recorded reply for {request.method} {request.url.path}"
        return httpx.Response(404, json={"error": message})

    def score(reply: dict[str, Any]) -> tuple[bool, int, int]:
        same = sum(1 for k, v in reply["query"].items() if query.get(k) == v)
        return reply["path"] == request.url.path, same, -abs(len(reply["query"]) - len(query))

    best = max(found, key=score)
    return httpx.Response(
        best["status"], text=best["body"], headers={"content-type": best["content_type"]}
    )


