{{ iter_signature(m) }}    ) -> AsyncIterator[{{ m.response_type }}]:
{{ page_loop(m, "await ") }}{% endif %}
{% endfor %}

    async def _request(
        self,
        method: str,
        url: str,
        params: dict[str, Any],
        headers: dict[str, str],
        json: dict[str, Any] | None = None,
    ) -> Any:
        params = {k: v for k, v in params.items() if v is not None}
        if json is not None:
            json = {k: v for k, v in json.items() if v is not None}
        attempt = 0
        while True:
            async with self._lock:  # one request at a time keeps the rate limit honest
                await asyncio.sleep(self._wait())
            try:
                response = await self._http.request(
                    method, url, params=params, headers=headers, json=json
                )
            except httpx.HTTPError as exc:
                delay = self._retry_delay(None, attempt)
                if delay is None:
                    raise {{ spec.error_class }}(0, f"network error: {exc}") from exc
            else:
                delay = self._retry_delay(response, attempt)
                if delay is None:
                    return self._result(response)
            await asyncio.sleep(delay)
            attempt += 1


def _parse_json(text: str) -> Any:
    stripped = text.lstrip()
    for guard in JSON_GUARDS:
        if stripped.startswith(guard):
            stripped = stripped[len(guard) :].lstrip(",").lstrip()
            break
    return json.loads(stripped)


def _safe_json(response: httpx.Response) -> Any:
    try:
        return _parse_json(response.text)
    except ValueError:
        return response.text[:500]


def _dump(value: Any) -> Any:
    if isinstance(value, BaseModel):
        return value.model_dump(by_alias=True)
    if isinstance(value, list):
        return [_dump(v) for v in value]
    return value


def _find_items(data: Any, depth: int = 0) -> list[Any] | None:
    """The main list of records in a response."""
    if isinstance(data, list):
        return data
    if not isinstance(data, dict) or depth > 2:
        return None
    best: list[Any] | None = None
    for value in data.values():
        found = value if isinstance(value, list) else _find_items(value, depth + 1)
        if found is not None and (best is None or len(found) > len(best)):
            best = found
    return best


def _has_more(data: Any) -> bool | None:
    if isinstance(data, dict):
        for key in ("has_next", "hasNext", "has_more", "hasMore"):
            if isinstance(data.get(key), bool):
                return bool(data[key])
    return None


def _next_cursor(data: Any) -> str | None:
    if not isinstance(data, dict):
        return None
    places = [data] + [data[k] for k in ("meta", "pagination", "paging", "pageInfo", "links")
                       if isinstance(data.get(k), dict)]
    for place in places:
        for key in ("next_cursor", "nextCursor", "cursor", "next", "after", "endCursor",
                    "next_page_token", "nextPageToken"):
            value = place.get(key)
            if isinstance(value, (str, int)) and not isinstance(value, bool) and str(value):
                return str(value)
    return None
