class _Base:
    BASE_URL = "{{ spec.base_url }}"

    def __init__(
        self,
        base_url: str,
{% for c in spec.credentials %}
        {{ c.arg }}: str | None,
{% endfor %}
        max_requests_per_second: float,
        max_retries: int,
    ) -> None:
        self.base_url = base_url.rstrip("/")
{% for c in spec.credentials %}
        self.{{ c.arg }} = {{ c.arg }} or os.environ.get("{{ c.env }}")
{% endfor %}
        self._interval = 1.0 / max_requests_per_second if max_requests_per_second > 0 else 0.0
        self._last_request = 0.0
        self._max_retries = max_retries

    def _credential(self, name: str) -> str:
        value: str | None = getattr(self, name)
        if not value:
            env = CREDENTIAL_ENV.get(name, "")
            raise {{ spec.error_classes.auth }}(0, f"Missing credential: pass {name}=... or set {env}")
        return value

    def _wait(self) -> float:
        """Seconds to wait before the next request, to keep to the rate limit."""
        wait = self._last_request + self._interval - time.monotonic()
        self._last_request = time.monotonic() + max(wait, 0.0)
        return max(wait, 0.0)

    def _retry_delay(self, response: httpx.Response | None, attempt: int) -> float | None:
        """How long to wait before retrying, or None to stop retrying."""
        if attempt >= self._max_retries:
            return None
        if response is None:  # network error
            return float(2**attempt)
        if response.status_code not in RETRY_STATUSES:
            return None
        retry_after = response.headers.get("retry-after", "")
        return float(retry_after) if retry_after.isdigit() else float(2**attempt)

    @staticmethod
    def _result(response: httpx.Response) -> Any:
        if response.status_code >= 400:
            raise _error_for(response.status_code, response.reason_phrase, _safe_json(response))
        try:
            return _parse_json(response.text)
        except ValueError as exc:
            raise {{ spec.error_class }}(
                response.status_code, "response is not JSON", response.text[:500]
            ) from exc


class {{ spec.class_name }}(_Base):
    """Client for {{ spec.domain }}.

    Use it as a context manager so the connection is closed:

        with {{ spec.class_name }}() as api:
{% if spec.methods %}
            result = api.{{ spec.methods[0].name }}({% for p in spec.methods[0].required %}{{ p.name }}={{ p.example or '...' }}{% if not loop.last %}, {% endif %}{% endfor %})
{% endif %}
{% if spec.credentials %}

    Credentials are read from these environment variables unless passed in:
{% for c in spec.credentials %}
        {{ c.arg }}: {{ c.env }}
{% endfor %}
{% endif %}

    Pass `http_client=httpx.Client(event_hooks=...)` to log or change every request.
    """

    def __init__(
        self,
        base_url: str = _Base.BASE_URL,
        *,
{% for c in spec.credentials %}
        {{ c.arg }}: str | None = None,
{% endfor %}
        timeout: float = 30.0,
        max_requests_per_second: float = 1.0,
        max_retries: int = 3,
        http_client: httpx.Client | None = None,
    ) -> None:
        super().__init__(
            base_url,
{% for c in spec.credentials %}
            {{ c.arg }},
{% endfor %}
            max_requests_per_second,
            max_retries,
        )
        self._http = http_client or httpx.Client(
            timeout=timeout, headers={"User-Agent": USER_AGENT, "Accept": "application/json"}
        )

    def close(self) -> None:
        self._http.close()

    def __enter__(self) -> {{ spec.class_name }}:
        return self

    def __exit__(self, *exc: object) -> None:
        self.close()
{% for m in spec.methods %}

    def {{ m.name }}(
{{ signature(m) }}    ) -> {{ m.response_type }}:
        """{{ m.summary | doc }}

        `{{ m.http_method }} {{ (m.host and 'https://' ~ m.host) or spec.base_url }}{{ m.path }}`
        """
        data = self._request(
{{ request_args(m) }}        )
        return TypeAdapter({{ m.response_type }}).validate_python(data)
{% if m.page_param %}

    def iter_{{ m.name }}(
{{ iter_signature(m) }}    ) -> Iterator[{{ m.response_type }}]:
{{ page_loop(m, "") }}{% endif %}
{% endfor %}

    def _request(
        self,
        method: str,
        url: str,
        params: dict[str, Any],
        headers: dict[str, str],
        json: dict[str, Any] | None = None,
    ) -> Any:
        params = {k: v for k, v in params.items() if v is not None}
        if json is not None:
            json = {k: v for k, v in json.items() if v is not None}
        attempt = 0
        while True:
            time.sleep(self._wait())
            try:
                response = self._http.request(
                    method, url, params=params, headers=headers, json=json
                )
            except httpx.HTTPError as exc:
                delay = self._retry_delay(None, attempt)
                if delay is None:
                    raise {{ spec.error_class }}(0, f"network error: {exc}") from exc
            else:
                delay = self._retry_delay(response, attempt)
                if delay is None:
                    return self._result(response)
            time.sleep(delay)
            attempt += 1


