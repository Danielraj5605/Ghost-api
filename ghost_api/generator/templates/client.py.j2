class {{ spec.error_class }}(Exception):
    """An API call failed. `status` is the HTTP status (0 for network errors)."""

    def __init__(self, status: int, message: str, body: Any = None) -> None:
        super().__init__(f"HTTP {status}: {message}" if status else message)
        self.status = status
        self.body = body


class {{ spec.error_classes.auth }}({{ spec.error_class }}):
    """401 or 403: a credential is missing, wrong or expired."""


class {{ spec.error_classes.not_found }}({{ spec.error_class }}):
    """404: no such resource (or the site moved this endpoint)."""


class {{ spec.error_classes.rate_limit }}({{ spec.error_class }}):
    """429 after all retries: slow down (see `max_requests_per_second`)."""


class {{ spec.error_classes.server }}({{ spec.error_class }}):
    """5xx after all retries: the site has a problem."""


def _error_for(status: int, message: str, body: Any = None) -> {{ spec.error_class }}:
    kind: type[{{ spec.error_class }}] = {{ spec.error_class }}
    if status in (401, 403):
        kind = {{ spec.error_classes.auth }}
    elif status == 404:
        kind = {{ spec.error_classes.not_found }}
    elif status == 429:
        kind = {{ spec.error_classes.rate_limit }}
    elif status >= 500:
        kind = {{ spec.error_classes.server }}
    return kind(status, message, body)
