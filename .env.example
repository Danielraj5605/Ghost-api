# Copy this file to .env and fill in your keys. Never commit .env.

# Main LLM (free): https://aistudio.google.com -> Get API key
GEMINI_API_KEY=

# Fallback LLM (free): https://console.groq.com -> API Keys
GROQ_API_KEY=

# Optional second fallback: https://openrouter.ai -> Keys
OPENROUTER_API_KEY=

# Where Ghost API stores captured traffic and memory
GHOST_API_DB=ghost_api.db

# Optional: override models or the fallback order
# GHOST_API_GEMINI_MODEL=gemini-2.5-flash
# GHOST_API_GROQ_MODEL=openai/gpt-oss-120b
# GHOST_API_GEMINI_LITE_MODEL=gemini-2.5-flash-lite
# GHOST_API_OPENROUTER_MODEL=qwen/qwen3.8-27b:free
# GHOST_API_PROVIDERS=gemini,groq,gemini-lite,openrouter
